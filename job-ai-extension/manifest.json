{
  "manifest_version": 3,
  "name": "AI Job Assistant & Auto-Fill",
  "version": "1.0",
  "description": "Analyze jobs and safely autofill applications on LinkedIn, Indeed, and Naukri.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "https://*.linkedin.com/*",
    "https://*.indeed.com/*",
    "https://*.naukri.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Job Assistant"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/*",
        "*://*.indeed.com/*",
        "*://*.naukri.com/*",
        "*://*.greenhouse.io/*",
        "*://*.lever.co/*"
      ],
      "js": ["content.js"]
    }
  ]
}